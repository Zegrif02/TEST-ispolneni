<Window x:Class="EmbodimentApiProbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Диагностика исполнений КОМПАС-3D" Height="1040" Width="1320"
        MinHeight="900" MinWidth="1050" WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2.0*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.0*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="20" FontWeight="Bold"
                   Text="Тест API исполнений КОМПАС-3D v25" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="ReadButton" Content="Подключиться и считать исполнения" Padding="14,8" Click="ReadButton_Click"/>
            <Button x:Name="SaveLogButton" Content="Сохранить лог" Padding="14,8" Margin="8,0,0,0" Click="SaveLogButton_Click"/>
            <Button x:Name="ClearButton" Content="Очистить" Padding="14,8" Margin="8,0,0,0" Click="ClearButton_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="18,0,0,0" Text="Ожидание"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                  SelectionChanged="ResultsGrid_SelectionChanged" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Индекс API (может измениться)" Binding="{Binding Index}" Width="180"/>
                <DataGridTextColumn Header="Базовая часть" Binding="{Binding BaseMarking}" Width="*"/>
                <DataGridTextColumn Header="Номер исполнения" Binding="{Binding ExecutionNumber}" Width="160"/>
                <DataGridTextColumn Header="Полное обозначение" Binding="{Binding FullMarking}" Width="*"/>
                <DataGridTextColumn Header="Вариант геометрии" Binding="{Binding IsVariant}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="3" Header="Контролируемая проверка записи — ТОЛЬКО НА ТЕСТОВОЙ КОПИИ" Margin="0,0,0,8" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" x:Name="SelectedRowText"
                           Text="Выбери строку исполнения в таблице. Для теста нужен непустой номер исполнения, например -02."
                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Новое базовое обозначение:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="NewBaseMarkingBox" MinWidth="260" Padding="6"
                         TextChanged="WriteConfirmation_TextChanged"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Подтверждение:" VerticalAlignment="Center" Margin="14,0,8,0"/>
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="ConfirmationPhraseBox" Width="125" Padding="6"
                         ToolTip="Для разблокировки введи слово ИЗМЕНИТЬ"
                         TextChanged="WriteConfirmation_TextChanged"/>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox x:Name="TestCopyCheckBox" VerticalAlignment="Center"
                              Content="Открыта отдельная тестовая копия; исходный рабочий документ закрыт"
                              Checked="WriteConfirmation_CheckChanged" Unchecked="WriteConfirmation_CheckChanged"/>
                    <Button x:Name="WriteTestButton" Content="ИЗМЕНИТЬ БАЗУ СЕМЕЙСТВА" Padding="16,8" Margin="18,0,0,0"
                            IsEnabled="False" Click="WriteTestButton_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="Проверка сохранения после закрытия и повторного открытия" Margin="0,0,0,8" Padding="8">
            <StackPanel>
                <TextBlock Text="Этот этап доступен только после успешного перестроения. Вручную сохрани тестовую копию в КОМПАС, закрой документ и заново открой тот же файл. Программу EmbodimentApiProbe оставь запущенной." TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="PersistenceCheckBox" VerticalAlignment="Center"
                              Content="Я сохранил документ в КОМПАС, закрыл его и заново открыл тот же файл"
                              Checked="PersistenceCheckBox_Changed" Unchecked="PersistenceCheckBox_Changed"/>
                    <Button x:Name="VerifyPersistenceButton" Content="Проверить сохранённое состояние" Padding="14,7" Margin="18,0,0,0"
                            IsEnabled="False" Click="VerifyPersistenceButton_Click"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="5" Header="Диагностический журнал" Margin="0,0,0,8">
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="6"/>
        </GroupBox>

        <TextBlock Grid.Row="6" Foreground="DarkRed" FontWeight="SemiBold" TextWrapping="Wrap">
            ВНИМАНИЕ: тест изменяет обозначение семейства исполнений в открытом документе в памяти КОМПАС и один раз вызывает RebuildDocument. Программа НЕ сохраняет и НЕ закрывает документ. Используй только отдельную одноразовую копию. После успешного теста сохранение выполняется вручную в КОМПАС; затем нужно закрыть и повторно открыть файл для проверки. При неуспешном тесте документ не сохранять.
        </TextBlock>
    </Grid>
</Window>
